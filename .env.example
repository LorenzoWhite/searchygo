# Used only by `pnpm cards:tag` (the one-time card tagging job). Copy to .env and fill in the
# key for whichever provider you tag with.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Used only by the card image upload to Cloudflare R2. From R2 > API Tokens (an "Object Read & Write"
# token for the bucket below); the account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
